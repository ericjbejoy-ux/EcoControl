{
  "name": "@carbontwin/api",
  "version": "0.1.0",
  "private": true,
  "description": "CarbonTwin Node.js API gateway — data ingestion layer (M2)",
  "type": "module",
  "scripts": {
    "dev:ingestion": "tsx watch src/ingestion/server.ts",
    "start:ingestion": "tsx src/ingestion/server.ts",
    "seed": "tsx src/ingestion/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carbontwin/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "csv-parse": "^5.6.0",
    "fastify": "^5.1.0",
    "hyparquet": "^1.6.0",
    "luxon": "^3.5.0",
    "node-cron": "^3.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@vitest/coverage-v8": "^2.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
